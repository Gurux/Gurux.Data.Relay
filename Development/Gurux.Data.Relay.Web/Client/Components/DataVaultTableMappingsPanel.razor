@using Gurux.Data.Relay.Configuration
@using Gurux.Data.Relay.Shared
@using Gurux.UI.Components.Panel

<Panel Height="auto">
    <PanelItem Height="auto" Width="35%" Id="datavault-left">
        <h3>Database tables</h3>
        @foreach (string table in Tables)
        {
            <div>
                <button type="button" class="@(table == _selectedTable ? "btn btn-primary" : "btn btn-link")"
                        @onclick="() => SelectTableAsync(table)">
                    @table
                </button>
            </div>
        }
        @if (!Tables.Any())
        {
            <p>No tables available.</p>
        }
    </PanelItem>
    <PanelItem Height="auto" Id="datavault-right">
        <h3>@(Export ? "Export mappings" : "Import mappings")</h3>
        @if (_selectedTable == null)
        {
            <p>Select a database table.</p>
        }
        else
        {
            <h4>@_selectedTable</h4>
            @foreach (var mapping in SelectedMappings)
            {
                <div class="mb-3">
                    <strong>@mapping.ObjectType: @mapping.SourceTable.Name → @mapping.TargetTable.Name</strong>
                    <button type="button" class="btn btn-link" @onclick="() => OnEdit.InvokeAsync(mapping)">Edit</button>
                    <button type="button" class="btn btn-link" @onclick="() => OnDelete.InvokeAsync(mapping)">Delete</button>
                    <ul>
                        @foreach (var column in mapping.Columns)
                        {
                            <li>@column.SourceColumn → @column.TargetColumn (@column.Role)</li>
                        }
                    </ul>
                </div>
            }
            @if (!SelectedMappings.Any())
            {
                <p>No mappings for this table.</p>
            }
            <button type="button" class="btn btn-success" @onclick="() => OnAdd.InvokeAsync()">Add mapping</button>
        }
    </PanelItem>
</Panel>

@code {
    [Parameter] public IReadOnlyList<string> Tables { get; set; } = [];
    [Parameter] public IEnumerable<GXDataVaultTableMapping> Mappings { get; set; } = [];
    [Parameter] public EventCallback<string> OnTableSelected { get; set; }
    private async Task SelectTableAsync(string table)
    {
        _selectedTable = table;
        await OnTableSelected.InvokeAsync(table);
    }
    [Parameter] public bool Export { get; set; }
    [Parameter] public EventCallback<GXDataVaultTableMapping> OnEdit { get; set; }
    [Parameter] public EventCallback<GXDataVaultTableMapping> OnDelete { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    private string? _selectedTable;
    protected override void OnParametersSet()
    {
        if (_selectedTable != null && !Tables.Contains(_selectedTable)) _selectedTable = null;
    }
    private IEnumerable<GXDataVaultTableMapping> SelectedMappings
    {
        get
        {
            if (!Export)
                return Mappings.Where(mapping => string.Equals(mapping.TargetTable.Name, _selectedTable, StringComparison.OrdinalIgnoreCase));
            var sources = Mappings.Where(mapping => string.Equals(mapping.TargetTable.Name, _selectedTable, StringComparison.OrdinalIgnoreCase))
                .Select(mapping => mapping.SourceTable.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
            bool staging = Mappings.Any(mapping => mapping.ObjectType == DataVaultObjectType.Staging &&
                string.Equals(mapping.TargetTable.Name, _selectedTable, StringComparison.OrdinalIgnoreCase));
            return Mappings.Where(mapping => sources.Contains(mapping.SourceTable.Name) &&
                (staging ? mapping.ObjectType != DataVaultObjectType.Staging && mapping.ObjectType != DataVaultObjectType.InformationMart
                    : mapping.ObjectType == DataVaultObjectType.InformationMart) &&
                !string.Equals(mapping.TargetTable.Name, _selectedTable, StringComparison.OrdinalIgnoreCase));
        }
    }
}
