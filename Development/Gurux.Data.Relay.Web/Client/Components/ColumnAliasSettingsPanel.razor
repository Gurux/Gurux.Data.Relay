@using Gurux.UI.Components.Enums

@inject IGXNotificationService NotificationService
@inject GXAdminApiClient Api

<section class="panel">
    <h2>Automatic column mappings</h2>
    <p>Rules work in both directions and ignore letter case. Use one * on each side for a shared name, for example *HashKey ↔ HK_*.</p>
    @if (_settings != null)
    {
        <fieldset disabled="@_saving">
            <GXTable Id="@($"{_gxTableIdPrefix}-1")" @key="_version" TItem="GXColumnAlias" Context="rule" @bind-Active="_active" ShowAllData="true" ShowAllUsers="false" ShowRemoved="false" ItemsProvider="GetItems">
                <HeaderContent><th>Column name</th><th>Equivalent name</th></HeaderContent>
                <ItemContent>
                    <td><button type="button" class="btn btn-link" @onclick="() => Open(rule)">@rule.Source</button></td>
                    <td>@rule.Target</td>
                </ItemContent>
                <MenuContent>
                    <ContextMenuItem Text="Edit" Image="oi oi-pencil" OnClick="EditSelected" />
                    <ContextMenuItem Text="Remove" Image="oi oi-trash" OnClick="RemoveSelectedAsync" />
                </MenuContent>
            </GXTable>
            <button type="button" class="btn btn-secondary" @onclick="() => Open(null)">Add mapping</button>
        </fieldset>
    }
</section>

@if (_draft != null)
{
    <GXValidationDialog EditContext="_editContext" Title="@(_original == null ? "Add automatic column mapping" : "Edit automatic column mapping")" OkButtonTitle="" CancelButtonTitle="" OnCancel="Cancel">

        <fieldset disabled="@_saving">
            <label>Column name</label>
            <InputText class="form-control" @bind-Value="_draft.Source" />
            <ValidationMessage For="@(() => _draft.Source)" />
            <label>Equivalent name</label>
            <InputText class="form-control" @bind-Value="_draft.Target" />
            <ValidationMessage For="@(() => _draft.Target)" />
            <button type="button" class="btn btn-success" @onclick="ConfirmAsync">OK</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </fieldset>
    </GXValidationDialog>
}

@code {
    private readonly string _notificationKey = Guid.NewGuid().ToString("N") + ":";
    private readonly string _gxTableIdPrefix = "columnaliassettingspanel-" + Guid.NewGuid().ToString("N");
    private GXSettings? _settings;
    private int _version;
    private bool _saving;
    private GXColumnAlias? _active, _original, _draft;
    private EditContext? _editContext;
    private ValidationMessageStore? _validation;
    protected override Task OnInitializedAsync() => LoadAsync();
    private ValueTask<ItemsProviderResult<GXColumnAlias>> GetItems(GXItemsProviderRequest request) =>
        ValueTask.FromResult(new ItemsProviderResult<GXColumnAlias>(_settings!.ColumnAliases, _settings.ColumnAliases.Count));
    private void Open(GXColumnAlias? rule)
    {
        if (_saving) return;
        _original = rule;
        _draft = new() { Source = rule?.Source ?? string.Empty, Target = rule?.Target ?? string.Empty };
        _editContext = new(_draft);
        _validation = new(_editContext);
        NotificationService.RemoveByKey(_notificationKey + "_error");
    }
    private void EditSelected() { if (_active != null) Open(_active); }
    private void Cancel() { if (!_saving) { _draft = _original = null; NotificationService.RemoveByKey(_notificationKey + "_error"); } }
    private async Task RemoveSelectedAsync()
    {
        if (_settings == null || _active == null || _saving || _draft != null) return;
        var rules = _settings.ColumnAliases.Where(c => !ReferenceEquals(c, _active)).ToList();
        await PersistAsync(rules);
    }
    private async Task ConfirmAsync()
    {
        if (_settings == null || _draft == null || _saving) return;
        _validation!.Clear();
        _draft.Source = _draft.Source.Trim();
        _draft.Target = _draft.Target.Trim();
        foreach (var field in new[] { nameof(GXColumnAlias.Source), nameof(GXColumnAlias.Target) })
        {
            string value = field == nameof(GXColumnAlias.Source) ? _draft.Source : _draft.Target;
            if (string.IsNullOrWhiteSpace(value) || value.Count(c => c == '*') > 1)
                _validation.Add(new FieldIdentifier(_draft, field), "Enter a name with at most one *.");
        }
        _editContext!.NotifyValidationStateChanged();
        if (_editContext.GetValidationMessages().Any()) return;
        var rules = _settings.ColumnAliases.ToList();
        if (_original == null) rules.Add(_draft);
        else
        {
            int index = rules.IndexOf(_original);
            if (index < 0) { NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, "The mapping no longer exists. Reopen the dialog.", string.Empty, _notificationKey + "_error", Closable: true)); return; }
            rules[index] = _draft;
        }
        if (await PersistAsync(rules)) Cancel();
    }
    private async Task LoadAsync()
    {
        NotificationService.RemoveByKey("Could not load (column alias settings)");

        try { _settings = await Api.GetSettingsAsync("datavault", default); ++_version; }
        catch (Exception ex) { NotificationService.ReportError(ex, "Could not load (column alias settings)"); }
    }
    private async Task<bool> PersistAsync(List<GXColumnAlias> rules)
    {
        if (_settings == null || _saving) return false;
        NotificationService.RemoveByKey("Could not persist (column alias settings)");

        _saving = true;
        try
        {
            var payload = System.Text.Json.JsonSerializer.Deserialize<GXSettings>(System.Text.Json.JsonSerializer.Serialize(_settings),
                new System.Text.Json.JsonSerializerOptions { PreferredObjectCreationHandling = System.Text.Json.Serialization.JsonObjectCreationHandling.Populate })!;
            payload.ColumnAliases = rules.Select(c => new GXColumnAlias { Source = c.Source, Target = c.Target }).ToList();
            await Api.SaveSettingsAsync("datavault", payload, default);
            _settings = payload;
            _active = null;
            ++_version;
            NotificationService.Add(new GXNotificationItem(NotificationLevel.Success, "Automatic column mappings", "Automatic column mappings saved.", Closable: true));
            return true;
        }
        catch (Exception ex) { NotificationService.ReportError(ex, "Could not persist (column alias settings)"); return false; }
        finally { _saving = false; }
    }
}

