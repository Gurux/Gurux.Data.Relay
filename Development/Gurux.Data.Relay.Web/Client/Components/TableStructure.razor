<div class="table-responsive">
    <GXTable Id="@($"{_gxTableIdPrefix}-1")" @key="Schema" TItem="GXColumnSchema" Context="column" ShowAllData="true" ShowAllUsers="false" ShowRemoved="false"
             ItemsProvider="GetColumns">
        <HeaderContent><th>Name</th><th>Type</th><th>Length</th><th>Nullable</th><th>Primary key</th><th>Indexed</th><th>Generated</th></HeaderContent>
        <ItemContent>
            <td>@column.Name</td><td>@(string.IsNullOrWhiteSpace(column.DbType) ? column.Type?.Name : column.DbType)</td><td>@column.MaxLength</td>
            <td>@(column.IsNullable ? "Yes" : "No")</td>
            <td>@(column.IsPrimaryKey ? "Yes" : "No")</td>
            <td>@(Schema.IsIndexed(column) ? "Yes" : "No")</td>
            <td>@(column.IsIdentity || column.IsAutoIncrement || column.IsComputed ? "Yes" : "No")</td>
        </ItemContent>
    </GXTable>
</div>

@code {
    private readonly string _gxTableIdPrefix = "tablestructure-" + Guid.NewGuid().ToString("N");
    [Parameter, EditorRequired] public GXTableSchema Schema { get; set; } = default!;

    private ValueTask<ItemsProviderResult<GXColumnSchema>> GetColumns(GXItemsProviderRequest request) =>
        ValueTask.FromResult(new ItemsProviderResult<GXColumnSchema>(Schema.Columns, Schema.Columns.Count));
}
