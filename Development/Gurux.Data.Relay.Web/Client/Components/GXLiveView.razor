@using Gurux.Data.Relay.Shared
@using Gurux.UI.Components.Enums
@implements IAsyncDisposable
@inject GXRealtimeClient Realtime
@inject IGXNotificationService NotificationService

<fieldset disabled="@(_refreshing || Busy)" inert="@(_refreshing || Busy ? string.Empty : null)" class="live-view" aria-busy="@(_refreshing || Busy)">
    @ChildContent
</fieldset>

@code {
    private readonly string _notificationKey = Guid.NewGuid().ToString("N") + ":";
    [Parameter] public string? Mode { get; set; }
    [Parameter] public GXRelayChangeKind Kinds { get; set; } = GXRelayChangeKind.Configuration;
    [Parameter] public Func<bool>? IsEditing { get; set; }
    [Parameter] public bool AnnounceEditing { get; set; } = true;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnStateChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Busy { get; set; }
    private string Resource => Mode ?? "store";
    private readonly Guid _owner = Guid.NewGuid();
    private readonly GXLiveUpdateState _state = new();
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _retry;
    private bool _disposed, _refreshing, _again;
    private string? _announced;
    private string? _connectionNotice, _conflictNotice, _editorNotice;
    private void UpdateNotifications()
    {
        NotificationService.SetMessage(ref _connectionNotice, Realtime.Connected ? null : "Live updates disconnected. Reconnecting automatically…", _notificationKey + "connection", NotificationLevel.Warning);
        NotificationService.SetMessage(ref _conflictNotice, _state.HasConflict ? "This information changed elsewhere. Your edits have been preserved. Cancel or discard your changes to load the latest values." : null, _notificationKey + "conflict", NotificationLevel.Warning);
        NotificationService.SetMessage(ref _editorNotice, Realtime.Editors.Any(e => e.Resource == Resource && e.Connections.Any(c => c != Realtime.ConnectionId)) ? "Another user is editing these settings." : null, _notificationKey + "editor", NotificationLevel.Warning);
    }
    private bool Editing => IsEditing?.Invoke() == true;

    protected override void OnInitialized()
    {
        Realtime.Changed += ReceiveAsync;
        Realtime.StatusChanged += StatusChanged;
        Realtime.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        string? resource = Editing && AnnounceEditing ? Resource : null;
        if (_announced != resource)
        {
            _announced = resource;
            await Realtime.SetEditingAsync(_owner, resource);
        }
        if (_state.Resume(Editing)) await ReloadAsync();
        UpdateNotifications();
    }

    private Task ReceiveAsync(GXRelayChange[] changes) => InvokeAsync(async () =>
    {
        NotificationService.RemoveByKey(_notificationKey + "_error");

        if (_disposed)
        {
            return;
        }
        var relevant = changes.Where(c => (c.Mode is null || c.Mode == Mode) &&
            ((c.Kind & Kinds) != 0 || (c.Kind & GXRelayChangeKind.Store) != 0)).ToArray();
        if (relevant.Length == 0) return;
        if (!Editing && OnStateChanged.HasDelegate && relevant.All(c => c.Kind == GXRelayChangeKind.State))
        {
            try
            {
                await OnStateChanged.InvokeAsync();
                NotificationService.RemoveByKey(_notificationKey + "_error");
            }
            catch (Exception ex)
            {
                NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, $"State update failed: {ex.Message}", ex.ToString(), _notificationKey + "_error", Closable: true));
            }
            StateHasChanged();
            return;
        }
        bool affectsDraft = relevant.Any(c => (c.Kind & (GXRelayChangeKind.Configuration | GXRelayChangeKind.Store | GXRelayChangeKind.Data)) != 0);
        if (_state.Receive(Editing, affectsDraft)) await ReloadAsync();
        StateHasChanged();
    });

    private async Task ReloadAsync()
    {
        NotificationService.RemoveByKey(_notificationKey + "_error");

        if (_refreshing) { _again = true; return; }
        _refreshing = true;
        StateHasChanged();
        try
        {
            do
            {
                _again = false;
                if (_disposed) return;
                // A user can start editing while an earlier reload is in flight.
                if (Editing) { _state.Receive(true, false); return; }
                await OnChanged.InvokeAsync();
                NotificationService.RemoveByKey(_notificationKey + "_error");
            } while (_again);
        }
        catch (Exception ex)
        {
            NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, $"Live update failed. Retrying automatically: {ex.Message}", ex.ToString(), _notificationKey + "_error", Closable: true));
            _retry ??= RetryAsync();
        }
        finally { _refreshing = false; if (!_disposed) StateHasChanged(); }
    }

    private void StatusChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }

    private async Task RetryAsync()
    {
        try
        {
            await Task.Delay(2000, _lifetime.Token);
            _retry = null;
            await InvokeAsync(ReloadAsync);
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        Realtime.Changed -= ReceiveAsync;
        Realtime.StatusChanged -= StatusChanged;
        NotificationService.RemoveByKey(_notificationKey + "connection");
        NotificationService.RemoveByKey(_notificationKey + "conflict");
        NotificationService.RemoveByKey(_notificationKey + "editor");
        await Realtime.SetEditingAsync(_owner, null);
    }
}
