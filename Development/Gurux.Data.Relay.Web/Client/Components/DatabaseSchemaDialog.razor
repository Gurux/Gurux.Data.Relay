@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Gurux.UI.Components.Enums

@inject IGXNotificationService NotificationService
@inject GXAdminApiClient Api
<HelpContext Topic="database-schema-import-and-export" />

<GXValidationDialog Model="@this" Title="@(Importing ? "Import schema" : "Export schema")" OkButtonTitle="" CancelButtonTitle="" OnCancel="CloseAsync">
    <p><strong>Database:</strong> @(Database.Description ?? Database.Type.ToString())</p>
    <fieldset disabled="@Progress.IsBusy">
        @if (Importing)
        {
            <label>Schema JSON file <InputFile OnChange="ReadFileAsync" accept=".json,application/json" /></label>
        }
        @if (_rows.Count > 0)
        {
            <p>Select the tables to @(Importing ? "import" : "export").</p>
            <div class="actions-row">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => SelectAll(true)">Select all</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="() => SelectAll(false)">Clear selection</button>
            </div>
            <GXTable Id="@($"{_gxTableIdPrefix}-1")" @key="_rows" TItem="SchemaRow" Context="row" ShowAllData="true"
                     ShowAllUsers="false" ShowRemoved="false" ItemsProvider="GetRows">
                <HeaderContent><th>Select</th><th>Table</th><th>Status</th></HeaderContent>
                <ItemContent>
                    <td><input type="checkbox" aria-label="@($"Select {row.Name}")" @bind="row.Selected" disabled="@row.Imported" />
                    <ValidationMessage For="@(() => row.Selected)" /></td>
                    <td>@row.Name</td>
                    <td>@row.Status</td>
                </ItemContent>
            </GXTable>
            <button type="button" class="btn btn-primary" disabled="@(!_rows.Any(row => row.Selected && !row.Imported))" @onclick="TransferAsync">
                @(Importing ? "Import selected" : "Export selected")
            </button>
        }
        <button type="button" class="btn btn-secondary" @onclick="CloseAsync">Close</button>
    </fieldset>
    @if (_downloadUri is not null)
    {
        <a class="btn btn-outline-success" href="@_downloadUri" download="Gurux.Data.Relay.tables.schema.json">Download schema</a>
    }
</GXValidationDialog>

@code {
    private readonly string _gxTableIdPrefix = "databaseschemadialog-" + Guid.NewGuid().ToString("N");
    [Parameter, EditorRequired] public GXDatabase Database { get; set; } = null!;
    [Parameter] public bool Importing { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<SchemaRow> _rows = [];
    private string? _downloadUri;

    private Task CloseAsync() => Progress.IsBusy ? Task.CompletedTask : OnClose.InvokeAsync();

    private sealed class SchemaRow
    {
        public string Name { get; init; } = "";
        public JsonElement Schema { get; init; }
        public bool Selected { get; set; }
        public bool Imported { get; set; }
        public string? Status { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Importing) return;
        NotificationService.RemoveByKey("Could not load database schema");

        try
        {
            var names = await Api.GetTablesAsync(Database, CancellationToken.None);
            _rows = names.Select(name => new SchemaRow { Name = name }).ToList();
            if (_rows.Count == 0) NotificationService.Add(new GXNotificationItem(NotificationLevel.Information, "Database schema", "No tables found in the selected database.", Closable: true));
        }
        catch (Exception ex) { NotificationService.ReportError(ex, "Could not load database schema"); }
    }

    private ValueTask<ItemsProviderResult<SchemaRow>> GetRows(GXItemsProviderRequest request)
        => ValueTask.FromResult(new ItemsProviderResult<SchemaRow>(_rows, _rows.Count));

    private void SelectAll(bool selected)
    {
        foreach (var row in _rows.Where(row => !row.Imported)) row.Selected = selected;
    }

    private async Task ReadFileAsync(InputFileChangeEventArgs args)
    {
        NotificationService.RemoveByKey("Could not read file (database schema)");

        if (Progress.IsBusy) return;
        using var progress = Progress.ProgressStart("Reading schema file…");
        _rows = [];
        try
        {
            await using var stream = args.File.OpenReadStream(10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            LoadSchemas(await reader.ReadToEndAsync());
        }
        catch (Exception ex) { NotificationService.ReportError(ex, "Could not read file (database schema)"); }
    }

    private void LoadSchemas(string json)
    {
        using var document = JsonDocument.Parse(json);
        var root = document.RootElement;
        var tables = root.ValueKind == JsonValueKind.Array ? root.EnumerateArray().ToArray() : [root];
        var rows = new List<SchemaRow>();
        foreach (var table in tables)
        {
            if (table.ValueKind != JsonValueKind.Object) throw new JsonException("Expected table schema objects.");
            string? name = null, owner = null;
            bool columns = false;
            foreach (var property in table.EnumerateObject())
            {
                if (property.Name.Equals("name", StringComparison.OrdinalIgnoreCase)) name = property.Value.GetString();
                if (property.Name.Equals("schema", StringComparison.OrdinalIgnoreCase)) owner = property.Value.GetString();
                if (property.Name.Equals("columns", StringComparison.OrdinalIgnoreCase))
                    columns = property.Value.ValueKind == JsonValueKind.Array && property.Value.GetArrayLength() > 0;
            }
            if (string.IsNullOrWhiteSpace(name) || !columns) throw new JsonException("Each table must contain a name and columns.");
            string fullName = string.IsNullOrWhiteSpace(owner) ? name : $"{owner}.{name}";
            if (rows.Any(row => row.Name.Equals(fullName, StringComparison.OrdinalIgnoreCase)))
                throw new JsonException($"Duplicate table '{fullName}'.");
            rows.Add(new SchemaRow { Name = fullName, Schema = table.Clone() });
        }
        _rows = rows;
        if (rows.Count == 0) NotificationService.Add(new GXNotificationItem(NotificationLevel.Information, "Database schema", "The file contains no tables.", Closable: true));
    }

    private async Task TransferAsync()
    {
        if (Progress.IsBusy) return;
        NotificationService.RemoveByKey("Could not transfer (database schema)");

        var selected = _rows.Where(row => row.Selected && !row.Imported).ToArray();
        if (selected.Length == 0) return;
        _downloadUri = null;
        int succeeded = 0;
        var exported = new List<JsonElement>();
        using (Progress.ProgressStart("Transferring database schema…"))
        {
            foreach (var row in selected)
            {
                try
                {
                    if (Importing)
                    {
                        await using var stream = new MemoryStream(Encoding.UTF8.GetBytes(row.Schema.GetRawText()));
                        await Api.ImportTableSchemaAsync(Database.Id, stream, CancellationToken.None);
                        row.Imported = true;
                        row.Selected = false;
                    }
                    else
                    {
                        string json = await Api.ExportTableSchemaAsync(Database.Id, row.Name, CancellationToken.None);
                        using var schema = JsonDocument.Parse(json);
                        exported.Add(schema.RootElement.Clone());
                    }
                    row.Status = Importing ? "Imported" : "Exported";
                    ++succeeded;
                }
                catch (Exception ex) { NotificationService.ReportError(ex, "Could not transfer (database schema)"); row.Status = ex.Message; }
            }
            if (!Importing && exported.Count > 0)
                _downloadUri = "data:application/json;charset=utf-8," + Uri.EscapeDataString(
                    JsonSerializer.Serialize(exported, new JsonSerializerOptions { WriteIndented = true }));
            NotificationService.Add(new GXNotificationItem(succeeded == selected.Length ? NotificationLevel.Success : NotificationLevel.Warning, "Database schema", $"{succeeded} of {selected.Length} tables {(Importing ? "imported" : "exported")}.", Closable: true));
        }
    }
}



