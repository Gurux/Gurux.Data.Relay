@using Gurux.UI.Components.Enums

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGXProgress Progress
@inject IGXNotificationService NotificationService

<div class="gx-mermaid">
    <div class="gx-mermaid-toolbar" role="group" aria-label="Diagram zoom">
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_ready || _zoom <= 0.1)" @onclick="() => ZoomAsync(_zoom / 1.25)" aria-label="Zoom out">−</button>
        <span aria-live="polite">@(_zoom.ToString("P0"))</span>
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_ready || _zoom >= 4)" @onclick="() => ZoomAsync(_zoom * 1.25)" aria-label="Zoom in">+</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(!_ready)" @onclick="() => ZoomAsync(1)">Reset zoom</button>
    </div>

    @if (string.IsNullOrWhiteSpace(Source))
    {
        <p role="status">No diagram to display.</p>
    }
    <div class="gx-mermaid-viewport" style="height: @Height" tabindex="0" role="region" aria-label="@Label" aria-busy="@_rendering">
        <div @ref="_host"></div>
    </div>
</div>

@code {
    private readonly string _notificationKey = Guid.NewGuid().ToString("N") + ":";
    /// <summary>Mermaid source, for example the result of GXSchemaManager.ExportMermaid().</summary>
    [Parameter] public string? Source { get; set; }
    [Parameter] public string Height { get; set; } = "600px";
    [Parameter] public string Label { get; set; } = "Database schema diagram";

    private ElementReference _host;
    private IJSObjectReference? _module;
    private string? _renderedSource;
    private bool _initialized, _rendering, _ready, _disposed;
    private double _zoom = 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        using var progress = Progress.ProgressStart("Rendering diagram…");
        if (_disposed || _rendering || (_initialized && _renderedSource == Source)) return;
        _rendering = true;
        _ready = false;
        NotificationService.RemoveByKey(_notificationKey + "_error");
        StateHasChanged();
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/GXMermaid.razor.js");
            while (!_disposed && (!_initialized || _renderedSource != Source))
            {
                var source = Source;
                _initialized = true;
                _renderedSource = source;
                _zoom = 1;
                NotificationService.RemoveByKey(_notificationKey + "_error");
                try
                {
                    await _module.InvokeVoidAsync("render", _host, source);
                    _ready = !string.IsNullOrWhiteSpace(source);
                }
                catch (JSException ex)
                {
                    _ready = false;
                    NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, $"Unable to display diagram: {ex.Message}", ex.ToString(), _notificationKey + "_error", Closable: true));
                }
            }
        }
        catch (JSException ex)
        {
            _initialized = true;
            _renderedSource = Source;
            NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, $"Unable to load diagram viewer: {ex.Message}", ex.ToString(), _notificationKey + "_error", Closable: true));
        }
        finally
        {
            _rendering = false;
            if (_disposed && _module is not null) await _module.DisposeAsync();
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task ZoomAsync(double value)
    {
        if (!_ready || _module is null || _disposed) return;
        _zoom = Math.Clamp(value, 0.1, 4);
        await _module.InvokeVoidAsync("zoom", _host, _zoom);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (!_rendering && _module is not null) await _module.DisposeAsync();
    }
}
