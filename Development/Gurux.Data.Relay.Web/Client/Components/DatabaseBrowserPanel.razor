@using Gurux.Data.Relay.Shared
@inject GXAdminApiClient Api

<GXLiveView Mode="@Mode" OnChanged="LoadSettingsAsync">

    <section class="panel">
        <h2>@Title</h2>

        <div class="actions-row">
            <DropdownSearch TValue="int" class="form-control" ShowItemsWhenEmpty="true" @bind-Value="_selectedIndex" Items="@(Enumerable.Range(0, _databases.Count))" Formatter="FormatDatabaseOption"><Template Context="option">@(FormatDatabaseOption(option))</Template></DropdownSearch>
            <button class="btn btn-outline-primary" @onclick="TestConnectionAsync" disabled="@(!_databases.Any())">Test connection</button>
            <button class="btn btn-outline-secondary" @onclick="LoadTablesAsync" disabled="@(!_databases.Any())">Load tables</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="notice">@_message</p>
        }

        <div class="row mt-3">
            <div class="col-md-4">
                <h3>Tables</h3>
                <ul class="list-group">
                    @foreach (string table in _tables)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@table</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadColumnsAsync(table)">Columns</button>
                        </li>
                    }
                </ul>
            </div>
            <div class="col-md-8">
                <h3>Columns: @_selectedTable</h3>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Primary key</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_columns.Count == 0)
                        {
                            <tr><td colspan="3">Select a table to inspect columns.</td></tr>
                        }
                        else
                        {
                            foreach (GXColumnSchema column in _columns)
                            {
                                <tr>
                                    <td>@column.Name</td>
                                    <td>@column.DbType</td>
                                    <td>@(column.IsPrimaryKey ? "Yes" : "No")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>


</GXLiveView>
@code {
    private static string FormatDatabaseOption(int index) => $"Database {index}";


    [Parameter, EditorRequired]
    public string Mode { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    private readonly List<GXDatabase> _databases = [];
    private readonly List<string> _tables = [];
    private readonly List<GXColumnSchema> _columns = [];
    private int _selectedIndex;
    private string _selectedTable = string.Empty;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        {
            GXSettings settings = await Api.GetSettingsAsync(Mode, CancellationToken.None);
            _databases.Clear();
            _databases.AddRange(settings.Databases);
            if (_selectedIndex >= _databases.Count)
            {
                _selectedIndex = 0;
            }
            _message = $"Loaded {_databases.Count} configured databases.";
        }
    }

    private async Task TestConnectionAsync()
    {
        GXDatabase? db = GetSelectedDatabase();
        if (db is null)
        {
            return;
        }
        {
            await Api.TestConnectionAsync(db, CancellationToken.None);
            _message = "Connection successful.";
        }
    }

    private async Task LoadTablesAsync()
    {
        GXDatabase? db = GetSelectedDatabase();
        if (db is null)
        {
            return;
        }

        IReadOnlyList<string> tables = await Api.GetTablesAsync(db, CancellationToken.None);
        _tables.Clear();
        _tables.AddRange(tables);
        _message = $"Loaded {_tables.Count} tables.";
    }

    private async Task LoadColumnsAsync(string table)
    {
        GXDatabase? db = GetSelectedDatabase();
        if (db is null)
        {
            return;
        }

        GXTableSchema schema = await Api.GetColumnsAsync(db, table, CancellationToken.None);
        _columns.Clear();
        _columns.AddRange(schema.Columns);

        _selectedTable = table;
    }

    private GXDatabase? GetSelectedDatabase()
    {
        if (_selectedIndex < 0 || _selectedIndex >= _databases.Count)
        {
            _message = "No database selected.";
            return null;
        }

        return _databases[_selectedIndex];
    }
}






