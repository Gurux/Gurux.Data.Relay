@using Gurux.UI.Components.Enums

@inject IGXNotificationService NotificationService
@inject GXAdminApiClient Api

<GXLiveView Mode="@Mode" Busy="@_saving" IsEditing="@(() => _saving || Dirty)" OnChanged="LoadAsync">
    <section class="panel">
        <h2>@Title CORS</h2>
        @if (_settings is not null)
        {
            <fieldset disabled="@_saving">
                <div class="form-check mb-2">
                    <input id="@(Mode + "-cors-enabled")" type="checkbox" class="form-check-input" @bind="_enabled" />
                    <label class="form-check-label" for="@(Mode + "-cors-enabled")">Enable CORS</label>
                </div>
                <div class="mb-2">
                    <label for="@(Mode + "-cors-origins")">Allowed origins</label>
                    <textarea id="@(Mode + "-cors-origins")" class="form-control" rows="4" @bind="_origins" @bind:event="oninput"></textarea>
                    <small class="form-text text-muted">One origin per line, for example https://app.example.com or http://localhost:3000. Do not include a path or trailing slash. Use * to allow any origin without credentials.</small>
                </div>
                <div class="form-check mb-2">
                    <input id="@(Mode + "-cors-credentials")" type="checkbox" class="form-check-input" @bind="_credentials" />
                    <label class="form-check-label" for="@(Mode + "-cors-credentials")">Allow credentials</label>
                </div>
                <button class="btn btn-success" disabled="@(!Dirty)" @onclick="SaveAsync">Save CORS settings</button>
                @if (Dirty)
                {
                    <button class="btn btn-secondary ms-2" @onclick="LoadAsync">Discard changes</button>
                }
            </fieldset>
        }
    </section>
</GXLiveView>

@code {
    [Parameter, EditorRequired] public string Mode { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    private GXSettings? _settings;
    private bool _enabled, _credentials, _saving;
    private string _origins = string.Empty;
    private string[] Origins => _origins.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.Ordinal).ToArray();
    private bool Dirty => _settings is not null && (_enabled != _settings.CorsEnabled || _credentials != _settings.CorsAllowCredentials || !Origins.SequenceEqual(_settings.CorsAllowedOrigins));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        NotificationService.RemoveByKey("Could not load (cors settings)");

        try
        {
            _settings = await Api.GetSettingsAsync(Mode, CancellationToken.None);
            _enabled = _settings.CorsEnabled;
            _credentials = _settings.CorsAllowCredentials;
            _origins = string.Join(Environment.NewLine, _settings.CorsAllowedOrigins);
        }
        catch (Exception ex) { NotificationService.ReportError(ex, "Could not load (cors settings)"); }
    }

    private async Task SaveAsync()
    {
        if (_saving || _settings is null) return;
        NotificationService.RemoveByKey("Could not save (cors settings)");

        _saving = true;
        try
        {
            if (_credentials && Origins.Contains("*")) throw new InvalidOperationException("Specify explicit origins when allowing credentials.");
            foreach (var origin in Origins)
                if (origin != "*" && (!Uri.TryCreate(origin, UriKind.Absolute, out var uri) ||
                    uri.Scheme is not ("http" or "https") || uri.AbsolutePath != "/" ||
                    uri.UserInfo.Length != 0 || uri.Query.Length != 0 || uri.Fragment.Length != 0 || origin.EndsWith('/')))
                    throw new InvalidOperationException("Use HTTP(S) origins without a path, trailing slash, credentials, query or fragment.");
            // Keep the original snapshot and concurrency stamp until the save succeeds.
            var payload = System.Text.Json.JsonSerializer.Deserialize<GXSettings>(
                System.Text.Json.JsonSerializer.Serialize(_settings),
                new System.Text.Json.JsonSerializerOptions { PreferredObjectCreationHandling = System.Text.Json.Serialization.JsonObjectCreationHandling.Populate })!;
            payload.CorsEnabled = _enabled;
            payload.CorsAllowCredentials = _credentials;
            payload.CorsAllowedOrigins = Origins.ToList();
            await Api.SaveSettingsAsync(Mode, payload, CancellationToken.None);
            _settings = payload;
            NotificationService.Add(new GXNotificationItem(NotificationLevel.Success, "CORS settings", "CORS settings saved.", Closable: true));
        }
        catch (Exception ex) { NotificationService.ReportError(ex, "Could not save (cors settings)"); }
        finally { _saving = false; }
    }
}
