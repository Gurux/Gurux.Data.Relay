@using Gurux.Data.Relay.Configuration
@using Gurux.Data.Relay.Shared
@using System.Text.Json
@using Gurux.UI.Components.Enums
@inject IGXNotificationService NotificationService

@implements IDisposable
@inject GXAdminApiClient Api
<HelpContext Topic="database-data" />

<GXLiveView Mode="@(Mode == "databases" ? null : Mode)" Kinds="@(GXRelayChangeKind.Configuration | GXRelayChangeKind.Data)" IsEditing="@(() => _importFile != null || _exporting)" Busy="_exporting" AnnounceEditing="false" OnChanged="RefreshAsync">

    <section class="panel">
        @if (_importFile != null)
        {
            <button class="btn btn-secondary" @onclick="() => _importFile = null">Cancel import</button>
        }
        <h2>Table Data</h2>
        <MenuControl @key="(CanImport, IsJson, _importFile is null, string.IsNullOrEmpty(_selectedTable))" RightCorner="true">
            <ChildContent>
                <MenuItem Text="Export" Image="oi oi-data-transfer-upload" Id="export-data" OnClick="ExportAsync" />
                @if (CanImport)
                {
                    <MenuItem Text="@(IsJson ? "Import JSON" : "Import CSV")" Image="oi oi-data-transfer-download"
                              Id="import-data" OnClick="ImportFileAsync"
                              ReadOnly="@(_importFile is null || string.IsNullOrEmpty(_selectedTable))" />
                }
            </ChildContent>
        </MenuControl>

        @if (_exportUri is not null)
        {
            <a class="btn btn-outline-success" href="@_exportUri" download="@_exportFileName">Download JSON</a>
        }
        <div class="actions-row">
            <label>
                Database
                <DropdownSearch class="form-control"
                                ShowItemsWhenEmpty="true"
                                @bind-Value="_databaseId"
                                Items="@(_databases.Select(database => database.Id).Prepend(Guid.Empty))" @bind-Value:after="LoadTablesAsync" Formatter="FormatDatabaseOption"><Template Context="option">@(FormatDatabaseOption(option))</Template></DropdownSearch>
            </label>
            <label>
                Table
                <DropdownSearch TValue="string" class="form-control"
                                ShowItemsWhenEmpty="true" @bind-Value="_selectedTable"
                                Items="@(_tables.Prepend(string.Empty))" @bind-Value:after="SelectTable" placeholder="Select table" disabled="@(_tables.Count == 0)"><Template Context="option">@(string.IsNullOrEmpty(option) ? "Select table" : option)</Template></DropdownSearch>
            </label>
        </div>
        @if (CanImport)
        {
            <fieldset disabled="@(string.IsNullOrEmpty(_selectedTable))" class="mt-3">
                <legend>Import CSV / JSON</legend>
                <div class="actions-row">
                    <FileSelector TType="byte[]" OnLoaded="SelectImportFile" MaxFileSize="@(10 * 1024 * 1024)" Filter=".csv,.json,text/csv,application/json" />
                    @if (!IsJson)
                    {
                        <label>
                            Delimiter
                            <DropdownSearch TValue="string" class="form-control"
                                            ShowItemsWhenEmpty="true"
                                            @bind-Value="_delimiter"
                                            Items="@(new[] { ",", ";", "\t" })"
                                            Formatter="FormatDelimiterOption"><Template Context="option">@(FormatDelimiterOption(option))</Template></DropdownSearch>
                        </label>
                        <label><input type="checkbox" @bind="_hasHeader" /> First row is a header</label>
                    }
                </div>
                @if (IsJson)
                {
                    <p class="text-muted">
                        UTF-8 JSON, maximum 10 MB. Use one object or an array of objects with all table column names, including IDs.
                        Names ignore letter case; their order does not matter. Use null for a database null; binary values use Base64.
                    </p>
                }
                else
                {
                    <p class="text-muted">
                        UTF-8 CSV, maximum 10 MB. Columns must follow the table column order, including IDs.
                        The header is skipped when selected. Use NULL for a database null; binary values use Base64.
                    </p>
                }
            </fieldset>
        }



        @if (_databases.Count == 0)
        {
            <p>No databases configured.</p>
        }
        else if (_databaseId != Guid.Empty && _tables.Count == 0)
        {

            <p>No tables available.</p>
        }
        @if (!string.IsNullOrEmpty(_selectedTable))
        {
            <div class="table-responsive">
                <GXTable Id="@($"{_gxTableIdPrefix}-1")" TItem="GXTableDataRow" Context="row" @key="_version" @ref="_dataTable" @bind-PageSize="_pageSize"
                         ShowAllUsers="false" ShowRemoved="false" ItemsProvider="ReadRowsAsync">
                    <HeaderContent>
                        @foreach (string column in _columns)
                        {
                            <th>@column</th>
                        }
                    </HeaderContent>
                    <FilterContent>
                        @foreach (string column in _columns)
                        {
                            <Fh @key="column">
                                <Search placeholder="@($"Search {column}...")" Value="@_filters.GetValueOrDefault(column)"
                                        ValueChanged="@(value => _filters[column] = value ?? string.Empty)"
                                        OnValueChanged="@(async (value) => await FiltersChangedAsync())" />
                            </Fh>
                        }
                    </FilterContent>
                    <ItemContent>
                        @foreach (var value in row.Values)
                        {
                            <td>@FormatValue(value)</td>
                        }
                    </ItemContent>
                </GXTable>
            </div>
            @if (_empty)
            {
                <p>The table is empty.</p>
            }
        }
    </section>


</GXLiveView>
@code {
    private readonly string _notificationKey = Guid.NewGuid().ToString("N") + ":";
    private readonly string _gxTableIdPrefix = "modetabledatapanel-" + Guid.NewGuid().ToString("N");
    private string FormatDatabaseOption(Guid id)
    {
        var database = _databases.FirstOrDefault(database => database.Id == id);
        return database == null ? "Select database" : string.IsNullOrWhiteSpace(database.Description) ? database.Type.ToString() : database.Description;
    }
    private static string FormatDelimiterOption(string value) => value switch { "," => "Comma", ";" => "Semicolon", _ => "Tab" };

    [Parameter, EditorRequired] public string Mode { get; set; } = string.Empty;
    private IReadOnlyList<GXDatabase> _databases = [];
    private IReadOnlyList<string> _tables = [];
    private IReadOnlyList<GXDataVaultTableMapping> _vaultMappings = [];
    private bool CanImport => Mode == "databases" || Mode.Equals("client", StringComparison.OrdinalIgnoreCase) ||
        Mode.Equals("datavault", StringComparison.OrdinalIgnoreCase) && _vaultMappings.Any(m =>
            m.Database == _databaseId && m.ObjectType == DataVaultObjectType.Staging &&
            string.Equals(m.TargetTable.Name, _selectedTable, StringComparison.OrdinalIgnoreCase));
    private List<string> _columns = [];
    private GXTable<GXTableDataRow>? _dataTable;
    private int _pageSize = 50;
    private readonly Dictionary<string, string> _filters = [];
    private async Task FiltersChangedAsync()
    {
        _exportUri = null;
        if (_dataTable != null) { _dataTable.CurrentPage = 0; await _dataTable.RefreshDataAsync(true); }
    }
    private Guid _databaseId;
    private string _selectedTable = string.Empty;
    private string? _importMessage;
    private byte[]? _importFile;
    private string? _importFileName;
    private bool IsJson => string.Equals(Path.GetExtension(_importFileName), ".json", StringComparison.OrdinalIgnoreCase);
    private string _delimiter = ",";
    private bool _hasHeader = true;
    private bool _empty;
    private bool _exporting;
    private string? _exportUri;
    private string? _exportFileName;

    private async Task ExportAsync()
    {
        if (_exporting) return;
        if (_databaseId == Guid.Empty || string.IsNullOrEmpty(_selectedTable))
        {
            NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, "Select a database and table first.", string.Empty, _notificationKey + "_error", Closable: true));
            return;
        }
        int version = _version;
        string tableName = _selectedTable;
        _exporting = true;
        _exportUri = null;
        NotificationService.RemoveByKey(_notificationKey + "_error");
        try
        {
            string json = await Api.ExportTableDataAsync(Mode, _databaseId, tableName,
                _lifetime.Token, new Dictionary<string, string>(_filters));
            if (version != _version) return;
            _exportFileName = $"{tableName}.json";
            _exportUri = "data:application/json;charset=utf-8," + Uri.EscapeDataString(json);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { if (version == _version) { NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, $"Could not export data: {ex.Message}", ex.ToString(), _notificationKey + "_error", Closable: true)); } }
        finally { _exporting = false; }
    }
    private int _version;
    private readonly CancellationTokenSource _lifetime = new();

    [Parameter] public Guid? InitialDatabaseId { get; set; }
    [Parameter] public string? InitialTable { get; set; }
    protected override Task OnInitializedAsync()
    {
        _databaseId = InitialDatabaseId ?? Guid.Empty;
        _selectedTable = InitialTable ?? string.Empty;
        return RefreshAsync();
    }

    private void SelectImportFile(byte[]? content, string name)
    {
        _importFile = content;
        _importFileName = name;
        NotificationService.SetMessage(ref _importMessage, null, _notificationKey + "_importMessage", NotificationLevel.Information);
        NotificationService.RemoveByKey(_notificationKey + "_error");
        if (!IsJson && !string.Equals(Path.GetExtension(_importFileName), ".csv", StringComparison.OrdinalIgnoreCase))
        {
            _importFile = null;
            NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.Add(new GXNotificationItem(NotificationLevel.Error, "Select a CSV or JSON file.", string.Empty, _notificationKey + "_error", Closable: true));
        }
        // FileSelector.OnLoaded is an Action, so Blazor does not rerender this parent automatically.
        StateHasChanged();
    }

    private async Task ImportFileAsync()
    {
        if (!CanImport || _importFile is null || string.IsNullOrEmpty(_selectedTable)) return;
        NotificationService.RemoveByKey(_notificationKey + "_error");
        NotificationService.SetMessage(ref _importMessage, null, _notificationKey + "_importMessage", NotificationLevel.Information);
        ++_version;
        try
        {
            await using var stream = new MemoryStream(_importFile, writable: false);
            int count = IsJson
                ? await Api.ImportTableJsonAsync(_databaseId, _selectedTable, stream, _lifetime.Token, Mode)
                : await Api.ImportTableCsvAsync(_databaseId, _selectedTable, stream, _delimiter, _hasHeader, _lifetime.Token, Mode);
            SelectTable();
            _importFile = null; NotificationService.SetMessage(ref _importMessage, $"Imported {count} rows.", _notificationKey + "_importMessage", NotificationLevel.Success);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.ReportError(ex, _notificationKey + "_error"); }
    }

    private async Task RefreshAsync()
    {
        NotificationService.RemoveByKey(_notificationKey + "_error");
        try
        {
            _databases = Mode == "databases" ? await Api.GetDatabaseCatalogAsync(_lifetime.Token) : await Api.GetDatabasesAsync(Mode, _lifetime.Token);
            if (Mode.Equals("datavault", StringComparison.OrdinalIgnoreCase))
                _vaultMappings = await Api.GetDataVaultMappingsAsync(_lifetime.Token);
            if (!_databases.Any(d => d.Id == _databaseId))
                _databaseId = _databases.FirstOrDefault()?.Id ?? Guid.Empty;
            await LoadTablesAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { _selectedTable = string.Empty; NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.ReportError(ex, _notificationKey + "_error"); }
    }

    private async Task LoadTablesAsync()
    {
        NotificationService.RemoveByKey(_notificationKey + "_error");
        string previous = _selectedTable;
        _selectedTable = string.Empty;
        _tables = [];
        SelectTable();
        try
        {
            var database = _databases.FirstOrDefault(d => d.Id == _databaseId);
            if (database is not null)
                _tables = await Api.GetTablesAsync(database, _lifetime.Token);
            _selectedTable = _tables.Contains(previous) ? previous : _tables.FirstOrDefault() ?? string.Empty;
            SelectTable();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.ReportError(ex, _notificationKey + "_error"); }
    }

    private void SelectTable()
    {
        _exportUri = null;
        _filters.Clear();
        _dataTable = null;
        _importFile = null;
        _importFileName = null;
        NotificationService.SetMessage(ref _importMessage, null, _notificationKey + "_importMessage", NotificationLevel.Information);
        ++_version;
        _columns = [];
        _empty = false;
        NotificationService.RemoveByKey(_notificationKey + "_error");
    }

    private async ValueTask<ItemsProviderResult<GXTableDataRow>> ReadRowsAsync(GXItemsProviderRequest request)
    {
        NotificationService.RemoveByKey(_notificationKey + "_error");

        int version = _version;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token, request.CancellationToken);
        try
        {
            var data = await Api.GetTableDataAsync(Mode, _databaseId, _selectedTable,
                request.StartIndex, request.Count, cancellation.Token, new Dictionary<string, string>(_filters));
            if (version != _version) return new([], 0);
            _columns = data.Columns;
            _empty = data.TotalCount == 0;
            await InvokeAsync(StateHasChanged);
            return new(data.Rows, data.TotalCount);
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { return new([], 0); }
        catch (Exception ex)
        {
            if (version == _version)
            {
                NotificationService.RemoveByKey(_notificationKey + "_error"); NotificationService.ReportError(ex, _notificationKey + "_error");
                _empty = false;
                await InvokeAsync(StateHasChanged);
            }
            return new([], 0);
        }
    }

    private static string FormatValue(JsonElement value) => value.ValueKind == JsonValueKind.Null ? "NULL" : value.ToString();
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}

