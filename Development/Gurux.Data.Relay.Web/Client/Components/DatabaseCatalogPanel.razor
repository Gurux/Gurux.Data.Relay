@using Gurux.Data.Relay.Shared
@using Gurux.Service.Orm.Common.Enums
@using Gurux.UI.Components.Panel

@inject GXAdminApiClient Api
@inject NavigationManager Navigation
@using Gurux.UI.Components.Enums

@inject IGXNotificationService NotificationService

<GXLiveView Kinds="GXRelayChangeKind.Configuration" IsEditing="@(() => _draft != null || _delete != null || _schemaDatabase != null || Progress.IsBusy || _describing || _describedSchema != null || _dataTableName != null)" OnChanged="LoadAsync">
    @if (_dataTableName is not null)
    {
        <div class="table-structure-dialog">
            <GXValidationDialog Model="@this" Title="@($"Data: {_dataTableName}")" OkButtonTitle="" CancelButtonTitle="Close" OnCancel="CloseData">
                <ModeTableDataPanel @key="(_dataDatabaseId, _dataTableName)" Mode="databases" InitialDatabaseId="_dataDatabaseId" InitialTable="@_dataTableName" />
            </GXValidationDialog>
        </div>
    }
    @if (_describedSchema is not null)
    {
        <div class="table-structure-dialog">
            <GXValidationDialog Model="@this" Title="@($"Table structure: {_describedSchema}")" OkButtonTitle="" CancelButtonTitle="Close" OnCancel="CloseDescription">
                <TableStructure Schema="_describedSchema" />
            </GXValidationDialog>
        </div>
    }
    @if (_draft is not null && _editContext is not null)
    {
        <GXValidationDialog Model="@_draft" Title="@(_isNewDatabase ? "Add database" : "Edit database")" OkButtonTitle="" CancelButtonTitle="" OnCancel="Cancel">
            @if (_draft is not null && _editContext is not null)
            {
                <EditForm EditContext="@_editContext" OnValidSubmit="SaveAsync" @key="_draft">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <label>Name</label><InputText class="form-control" @bind-Value="_draft.Description" />
                    <label>Database type</label>
                    <InputSelect class="form-select" @bind-Value="_draft.Type">
                        @foreach (var type in Enum.GetValues<DatabaseType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                    <label>Connection string</label><InputTextArea class="form-control" @bind-Value="_draft.ConnectionString" />
                    <label>Record source (default)</label><InputText class="form-control" @bind-Value="_draft.RecordSource" />
                    <label>Delete mode</label>
                    <InputSelect class="form-select" @bind-Value="_draft.DeleteMode">
                        @foreach (var mode in Enum.GetValues<DeleteMode>())
                        {
                            <option value="@mode">@mode</option>
                        }
                    </InputSelect>
                    <label>Deleted column (for logical delete)</label><InputText class="form-control" @bind-Value="_draft.DeletedColumn" />
                    <div class="actions-row">
                        <button type="button" class="btn btn-secondary" disabled="@Progress.IsBusy" @onclick="TestAsync">Test connection</button>
                        <button type="submit" class="btn btn-primary" disabled="@Progress.IsBusy">Save</button>
                        <button type="button" class="btn btn-secondary" disabled="@Progress.IsBusy" @onclick="Cancel">Cancel</button>
                    </div>
                </EditForm>
            }
        </GXValidationDialog>
    }
    @if (_delete is not null)
    {
        <GXValidationDialog Model="@_delete" Title="Remove database" OkButtonTitle="" CancelButtonTitle="" OnCancel="Cancel">
            <p>Delete database <strong>@Label(_delete)</strong> from the catalog?</p>
            <button class="btn btn-danger" disabled="@Progress.IsBusy" @onclick="DeleteAsync">Delete</button>
            <button class="btn btn-secondary" disabled="@Progress.IsBusy" @onclick="Cancel">Cancel</button>
        </GXValidationDialog>
    }
    <Panel Height="fill">
        <PanelItem Id="catalog-databases" Width="50%" Height="fill">
            <h2>Databases</h2>
            <p>Define databases here once, then select them in Client, Server and Data Vault.</p>
            @if (_schemaDatabase is not null)
            {
                <h3>Import schema</h3>
                <p>Database: <strong>@Label(_schemaDatabase)</strong></p>
                <p>Select a JSON schema file containing one table or a list of tables. Existing tables will not be overwritten.</p>
                <InputFile OnChange="ImportSchemaAsync" accept=".json,application/json" disabled="@Progress.IsBusy" />
                <button class="btn btn-secondary" disabled="@Progress.IsBusy" @onclick="Cancel">Cancel</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="AddDatabase">Add database</button>
                <GXTable Id="@($"{_gxTableIdPrefix}-2")" @key="_databases" TItem="GXDatabase" Context="database"
                         Active="_selectedDatabase" ActiveChanged="SelectDatabaseAsync"
                         ShowAllData="true" ShowAllUsers="false" ShowRemoved="false"
                         ItemsProvider="GetDatabaseItems">
                    <HeaderContent>
                        <th>Name</th><th>Type</th><th>Record source</th>
                    </HeaderContent>
                    <ItemContent>
                        <td>@Label(database)</td>
                        <td><LinkButton Target="database" OnClick="Edit" Text="@database.Type.ToString()" /></td>
                        <td>@database.RecordSource</td>
                    </ItemContent>
                    <MenuContent>
                        <ContextMenuItem Text="Diagram" Image="oi oi-project" OnClick="OpenDiagram" />
                        <ContextMenuItem Text="Edit" Image="oi oi-pencil" OnClick="EditSelected" />
                        <ContextMenuItem Text="Import schema" Image="oi oi-data-transfer-download" OnClick="ImportSelected" />
                        <ContextMenuItem Text="Export schema" Image="oi oi-data-transfer-upload" OnClick="ExportSelected" />
                        <ContextMenuItem Text="Delete" Image="oi oi-trash" OnClick="DeleteSelected" />
                    </MenuContent>
                </GXTable>
            }
        </PanelItem>
        <PanelItem Id="catalog-source-tables" Height="fill">
            <h2>Source tables</h2>

            @if (_selectedDatabase is null)
            {
                <p>Select a database to view its source tables.</p>
            }
            else
            {
                <p>@Label(_selectedDatabase)</p>
                <button class="btn btn-secondary" disabled="@_tablesLoading" @onclick="() => SelectDatabaseAsync(_selectedDatabase)">Refresh</button>
                @if (_tablesLoading)
                {
                    
                }
                else if (_tablesError is not null)
                {

                    
                }
                else if (_sourceTables.Count == 0)
                {

                    <p>No source tables found.</p>
                }
                else
                {
                    <GXTable Id="@($"{_gxTableIdPrefix}-1")" @key="_sourceTables" TItem="SourceTableRow" Context="table" @bind-Active="_activeSourceTable"
                             ShowAllData="true" ShowAllUsers="false" ShowRemoved="false" ItemsProvider="GetSourceTableItems">
                        <HeaderContent><th>Name</th></HeaderContent>
                        <ItemContent>
                            <td><button type="button" class="btn btn-link" @onclick="() => OpenTableData(table)">@table.Name</button></td>
                        </ItemContent>
                        <MenuContent>
                            <ContextMenuItem Text="Describe" Image="oi oi-list-rich" OnClick="DescribeSelectedAsync" />
                            <ContextMenuItem Text="Data" Image="oi oi-grid-three-up" OnClick="OpenData" />
                        </MenuContent>
                    </GXTable>
                }
            }
        </PanelItem>
    </Panel>
</GXLiveView>

@code {
    private readonly string _notificationKey = Guid.NewGuid().ToString("N") + ":";
    private readonly string _gxTableIdPrefix = "databasecatalogpanel-" + Guid.NewGuid().ToString("N");
    [Inject] public IGXTopMenu? TopMenu { get; set; }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && TopMenu is not null) { TopMenu.Clear(); TopMenu.EditContext = null; }
    }
    private sealed record SourceTableRow(string Name) { public string Id => Name; }
    private SourceTableRow? _activeSourceTable;
    private ValueTask<ItemsProviderResult<SourceTableRow>> GetSourceTableItems(GXItemsProviderRequest request)
        => ValueTask.FromResult(new ItemsProviderResult<SourceTableRow>(_sourceTables.Select(name => new SourceTableRow(name)).ToArray(), _sourceTables.Count));
    private void OpenDiagram() { if (_selectedDatabase is not null) Navigation.NavigateTo($"/databases/{_selectedDatabase.Id}/diagram"); }
    private void EditSelected() { if (_selectedDatabase is not null) Edit(_selectedDatabase); }

    private void ImportSelected() => _schemaDatabase = _selectedDatabase;
    private void ExportSelected()
    {
        if (_selectedDatabase is not null)
            Navigation.NavigateTo($"api/databases/{_selectedDatabase.Id}/schema", forceLoad: true);
    }
    private void DeleteSelected() => _delete = _selectedDatabase;
    private Task DescribeSelectedAsync() => _activeSourceTable is not null && _sourceTables.Contains(_activeSourceTable.Name)
        ? DescribeAsync(_activeSourceTable.Name) : Task.CompletedTask;
    private void OpenData()
    {
        if (_selectedDatabase is not null && _activeSourceTable is not null && _sourceTables.Contains(_activeSourceTable.Name))
        {
            _dataDatabaseId = _selectedDatabase.Id;
            _dataTableName = _activeSourceTable.Name;
        }
    }
    private Guid _dataDatabaseId;
    private string? _dataTableName;
    private void OpenTableData(SourceTableRow table) { _activeSourceTable = table; OpenData(); }
    private void CloseData() => _dataTableName = null;
    private GXTableSchema? _describedSchema;
    private bool _describing;
    private string? _describeError;
    private async Task DescribeAsync(string name)
    {
        if (_describing || _selectedDatabase is null) return;
        NotificationService.RemoveByKey("Could not describe (database catalog)");
        NotificationService.RemoveByKey(_notificationKey + "_describeError");

        var database = _selectedDatabase;
        var request = _tablesRequest;
        _describing = true;
        NotificationService.SetMessage(ref _describeError, null, _notificationKey + "_describeError", NotificationLevel.Error);
        _describedSchema = null;
        try
        {
            var schema = await Api.GetColumnsAsync(database, name, CancellationToken.None);
            if (request != _tablesRequest) return;
            if (string.IsNullOrEmpty(schema.Name)) schema.Name = name;
            _describedSchema = schema;
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "Could not describe (database catalog)");
            if (request == _tablesRequest)
            {
                _describeError = $"Could not describe {name}: {ex.Message}";
            }
        }
        finally { _describing = false; }
    }
    private void CloseDescription() => _describedSchema = null;
    private GXDatabase? _selectedDatabase;
    private IReadOnlyList<string> _sourceTables = [];
    private string? _tablesError;
    private bool _tablesLoading;
    private int _tablesRequest;
    private async Task SelectDatabaseAsync(GXDatabase database)
    {
        NotificationService.RemoveByKey("Could not select database (database catalog)");
        NotificationService.RemoveByKey(_notificationKey + "_describeError");
        NotificationService.RemoveByKey(_notificationKey + "_tablesError");

        var request = ++_tablesRequest;
        _activeSourceTable = null;
        _describedSchema = null;
        NotificationService.SetMessage(ref _describeError, null, _notificationKey + "_describeError", NotificationLevel.Error);
        _selectedDatabase = database;
        _sourceTables = [];
        NotificationService.SetMessage(ref _tablesError, null, _notificationKey + "_tablesError", NotificationLevel.Error);
        _tablesLoading = true;
        try
        {
            NotificationService.RemoveByKey("Could not select database (database catalog)");
            var tables = await Api.GetTablesAsync(database, default);
            if (request == _tablesRequest) _sourceTables = tables.OrderBy(name => name).ToArray();
        }
        catch (Exception ex) { 
            NotificationService.ReportError(ex, "Could not select database (database catalog)"); 
            if (request == _tablesRequest) _tablesError = ex.Message; }
        finally { if (request == _tablesRequest) _tablesLoading = false; }
    }
    private ValueTask<ItemsProviderResult<GXDatabase>> GetDatabaseItems(GXItemsProviderRequest request)
        => ValueTask.FromResult(new ItemsProviderResult<GXDatabase>(_databases, _databases.Count));
    private List<GXDatabase> _databases = [];
    private bool _isNewDatabase;
    private GXDatabase? _draft, _delete, _schemaDatabase;
    private EditContext? _editContext;
    private static string Label(GXDatabase database) => string.IsNullOrWhiteSpace(database.Description) ? database.Id.ToString() : database.Description;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        NotificationService.RemoveByKey("Could not load database catalog");

        try
        {
            NotificationService.RemoveByKey("Could not load database catalog");
            _databases = await Api.GetDatabaseCatalogAsync(default);
            var selected = _databases.FirstOrDefault(d => d.Id == _selectedDatabase?.Id) ?? _databases.FirstOrDefault();
            if (selected is not null) await SelectDatabaseAsync(selected);
            else { ++_tablesRequest; _selectedDatabase = null; _sourceTables = []; _tablesLoading = false; }
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "Could not load database catalog");
        }
    }
    private void AddDatabase()
    {
        _isNewDatabase = true;
        _draft = new GXDatabase();
        _editContext = new EditContext(_draft);
    }
    private void Edit(GXDatabase database)
    {
        _isNewDatabase = false;
        _draft = new()
        {
            Id = database.Id,
            ConcurrencyStamp = database.ConcurrencyStamp,
            Description = database.Description,
            Type = database.Type,
            ConnectionString = database.ConnectionString,
            RecordSource = database.RecordSource,
            DeleteMode = database.DeleteMode,
            DeletedColumn = database.DeletedColumn
        };
        _editContext = new EditContext(_draft);
    }
    private void Cancel()
    {
        if (Progress.IsBusy) return;
        _isNewDatabase = false;
        _draft = null;
        _editContext = null;
        _delete = null;
        _schemaDatabase = null;
    }
    private async Task ImportSchemaAsync(InputFileChangeEventArgs args)
    {
        if (Progress.IsBusy || _schemaDatabase is null) return;
        var database = _schemaDatabase;
        NotificationService.Add(new GXNotificationItem(NotificationLevel.Information, "Database catalog", "Importing schema...", Closable: true));
        NotificationService.RemoveByKey("Could not import schema (database catalog)");
        try
        {
            await using var stream = args.File.OpenReadStream(10 * 1024 * 1024);
            await Api.ImportCatalogSchemaAsync(database.Id, stream, default);
            _schemaDatabase = null;
            await SelectDatabaseAsync(database);
            NotificationService.Add(new GXNotificationItem(NotificationLevel.Success, "Database catalog", $"Schema imported into {Label(database)}. Configure the created tables in the required mode.", Closable: true));
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "Could not import schema (database catalog)");
        }
    }
    private async Task SaveAsync()
    {
        if (Progress.IsBusy || _draft is null) return;
        NotificationService.RemoveByKey("Could not save (database catalog)");
        try
        {
            await Api.SaveCatalogDatabaseAsync(_draft, default);
            _isNewDatabase = false;
            _draft = null;
            _editContext = null;
            NotificationService.Add(new GXNotificationItem(NotificationLevel.Success, "Database catalog", "Database saved.", Closable: true)); await LoadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "Could not save (database catalog)");
        }
    }
    private async Task DeleteAsync()
    {
        if (Progress.IsBusy || _delete is null) return;
        NotificationService.RemoveByKey("Could not delete (database catalog)");
        try
        {
            await Api.DeleteCatalogDatabaseAsync(_delete, default);
            _delete = null;
            NotificationService.Add(new GXNotificationItem(NotificationLevel.Success, "Database catalog", "Database deleted.", Closable: true));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "Could not delete (database catalog)");
        }
    }
    private async Task TestAsync()
    {
        if (Progress.IsBusy || _draft is null)
        {
            return;
        }
        NotificationService.RemoveByKey("Could not test (database catalog)");
        try { await Api.TestCatalogDatabaseAsync(_draft, default); NotificationService.Add(new GXNotificationItem(NotificationLevel.Success, "Database catalog", "Connection successful.", Closable: true)); }
        catch (Exception ex)
        {
            NotificationService.ReportError(ex, "Could not test (database catalog)");
        }
    }
}

