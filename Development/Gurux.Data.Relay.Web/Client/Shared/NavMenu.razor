<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Gurux Data Relay</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Overview
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="databases">
                <span class="oi oi-hard-drive" aria-hidden="true"></span> Databases
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="client">
                <span class="oi oi-data-transfer-upload" aria-hidden="true"></span> Client
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="server">
                <span class="oi oi-data-transfer-download" aria-hidden="true"></span> Server
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="datavault">
                <span class="oi oi-lock-locked" aria-hidden="true"></span> Data Vault
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="oi oi-cog" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
        <GXLiveView Kinds="GXRelayChangeKind.Store" OnChanged="LoadUpdateStatusAsync">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="update">
                    <span class="oi oi-reload" aria-hidden="true"></span> Update
                    @if (_updateRequired)
                    {
                        <span class="badge bg-warning text-dark ms-1" title="Configuration table updates required">!</span>
                    }
                </NavLink>
            </div>
        </GXLiveView>
    </nav>
</div>

@code {
    [Inject] public GXAdminApiClient Api { get; set; } = default!;
    private bool _updateRequired;
    protected override Task OnInitializedAsync() => LoadUpdateStatusAsync();
    private async Task LoadUpdateStatusAsync()
    {
        NotificationService.RemoveByKey("nav-update-status");

        try { _updateRequired = (await Api.GetConfigurationTableChangesAsync(CancellationToken.None)).Count != 0; }
        catch (Exception ex) { NotificationService.RemoveByKey("nav-update-status"); NotificationService.ReportError(ex, "nav-update-status"); _updateRequired = false; }
    }
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

