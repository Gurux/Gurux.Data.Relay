@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <Spinner />
        <Help />
        <TopMenu>
            <article class="content px-4">
                <SoftwareUpdateNotification />
                <NotificationsTile />
                @Body
            </article>
        </TopMenu>
    </main>
</div>

@code {
    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        foreach (var notification in NotificationService.Notifications
            .Where(item => item.Scope == Gurux.UI.Components.Enums.NotificationScope.Page).ToArray())
            NotificationService.Remove(notification.Id);
    }

    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}


