@page "/update"
@inject GXAdminApiClient Api

<PageTitle>Update Configuration Tables</PageTitle>
<HelpContext Topic="update-configuration-tables" />
<h1>Update Configuration Tables</h1>
@if (_changes.Count != 0)
{
    <p>Update the following configuration tables to the current schema.</p>
    <ul>
        @foreach (var table in _changes)
        {
            <li>@table.TableName: @string.Join("; ", table.Changes)</li>
        }
    </ul>
    <button class="btn btn-primary" disabled="@_busy" @onclick="UpdateAsync">
        @(_busy ? "Updating…" : "Update tables")
    </button>
}
else if (_message is null)
{

    <p>Configuration tables are up to date.</p>
}
@if (_message is not null)
{
    <div class="alert @(_failed ? "alert-danger" : "alert-success") mt-3" role="alert">@_message</div>
}

@code {
    private List<GXConfigurationTableChange> _changes = [];
    protected override async Task OnInitializedAsync()
    {
        try { _changes = await Api.GetConfigurationTableChangesAsync(CancellationToken.None); }
        catch (Exception ex) { _failed = true; _message = ex.Message; }
    }
    private bool _busy;
    private bool _failed;
    private string? _message;

    private async Task UpdateAsync()
    {
        if (_busy) 
        {
            return;
        }
        _busy = true;
        _message = null;
        _failed = false;
        try
        {
            await Api.UpdateConfigurationTableAsync(CancellationToken.None);
            _changes = await Api.GetConfigurationTableChangesAsync(CancellationToken.None);
            _message = _changes.Count == 0 ? "Configuration tables updated successfully." : "Some tables still require an update.";
        }
        catch (Exception ex)
        {
            _failed = true;
            _message = ex.Message;
        }
        finally { _busy = false; }
    }
}
