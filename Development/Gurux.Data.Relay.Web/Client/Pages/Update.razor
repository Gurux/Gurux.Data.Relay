@page "/update"
@inject GXAdminApiClient Api

<PageTitle>Updates</PageTitle>
<HelpContext Topic="software-updates" />
<h1>Updates</h1>
<SoftwareUpdatePanel />
<h2>Update Configuration Tables</h2>
@if (_changes.Count != 0)
{
    <p>Update the following configuration tables to the current schema.</p>
    <ul>
        @foreach (var table in _changes)
        {
            <li>@table.TableName: @string.Join("; ", table.Changes)</li>
        }
    </ul>
    <button class="btn btn-primary" disabled="@Progress.IsBusy" @onclick="UpdateAsync">
        @(Progress.IsBusy ? "Updating…" : "Update tables")
    </button>
}
else if (!Progress.IsBusy && _message is null)
{

    <p>Configuration tables are up to date.</p>
}


@code {
    private readonly string _notificationKey = Guid.NewGuid().ToString("N") + ":";
    private List<GXConfigurationTableChange> _changes = [];
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        NotificationService.RemoveByKey(_notificationKey + "_message");

        try { _changes = await Api.GetConfigurationTableChangesAsync(CancellationToken.None); }
        catch (Exception ex) { NotificationService.SetMessage(ref _message, ex.Message, _notificationKey + "_message", NotificationLevel.Error); }
        finally
        {
            StateHasChanged();
        }
    }
    private string? _message;

    private async Task UpdateAsync()
    {
        NotificationService.RemoveByKey(_notificationKey + "_message");

        if (Progress.IsBusy) 
        {
            return;
        }
        NotificationService.SetMessage(ref _message, null, _notificationKey + "_message", NotificationLevel.Information);
        try
        {
            await Api.UpdateConfigurationTableAsync(CancellationToken.None);
            _changes = await Api.GetConfigurationTableChangesAsync(CancellationToken.None);
            NotificationService.SetMessage(ref _message, _changes.Count == 0 ? "Configuration tables updated successfully." : "Some tables still require an update.", _notificationKey + "_message", _changes.Count == 0 ? NotificationLevel.Success : NotificationLevel.Warning);
        }
        catch (Exception ex)
        {
            NotificationService.SetMessage(ref _message, ex.Message, _notificationKey + "_message", NotificationLevel.Error);
        }
    }
}
