@page "/databases"
@page "/databases/data"
@using Gurux.UI.Components.Tab
@inject NavigationManager Navigation



<TabControl Active="@_path" SelectionChanged="@(page => _path = page.Path)">
    <ChildContent>
        <TabPage Path="/databases" Text="Databases" Icon="oi oi-hard-drive">
            <HelpContext Topic="databases" />
            <DatabaseCatalogPanel />
        </TabPage>
        <TabPage Path="/databases/data" Text="Data" Icon="oi oi-grid-three-up">
            <HelpContext Topic="database-data" />
            <ModeTableDataPanel @key="(DatabaseId, Table)" Mode="databases" InitialDatabaseId="DatabaseId" InitialTable="@Table" />
        </TabPage>
    </ChildContent>
</TabControl>

@code {
    [SupplyParameterFromQuery(Name = "databaseId")] public Guid? DatabaseId { get; set; }
    [SupplyParameterFromQuery(Name = "table")] public string? Table { get; set; }
    private string _path = "/databases";
    protected override void OnParametersSet() => _path = new Uri(Navigation.Uri).AbsolutePath;
}