@page "/server"
@page "/server/transports"
@page "/server/state"
@page "/server/log"
@page "/server/overview"

@using Gurux.UI.Components.Tab
@inject NavigationManager Navigation

<TabControl Active="@(Path?.StartsWith('/') == true ? Path : $"/server/{Path}")" SelectionChanged="@SelectionChanged">
    <TabTextTemplate>
        <Image Value="@context.Icon" />
        <LocalizedText Value="@context.Text" />
    </TabTextTemplate>
    <ChildContent>
        <TabPage Path="/server/transports" Text="Transports" Icon="oi oi-transfer">
            <HelpContext Topic="transports--receiving-and-table-mappings" />
            <ModeTransportsPanel Mode="server" />
        </TabPage>
        <TabPage Path="/server/state" Text="State" Icon="oi oi-dashboard">
            <HelpContext Topic="state--receiving-state" />
            <ModeStatePanel Mode="server" Title="Server Runtime State" />
        </TabPage>
        <TabPage Path="/server/log" Text="Log" Icon="oi oi-spreadsheet">
            <HelpContext Topic="log--server-log" />
            <ModeEventsPanel Mode="server" Title="Server Log" />
        </TabPage>
        <TabPage Path="/server/overview" Text="Settings" Icon="oi oi-cog">
            <HelpContext Topic="settings--server-settings" />
            <ModeSettingsPanel Mode="server" Title="Server Settings" />
        </TabPage>
    </ChildContent>
</TabControl>

@code {

    private string? Path { get; set; }

    protected override void OnParametersSet()
    {
        Path = new Uri(Navigation.Uri).AbsolutePath;
    }

    /// <summary>
    /// User has selected a new tab.
    /// </summary>
    /// <param name="page">Tab page.</param>
    void SelectionChanged(TabPage page)
    {
        Path = page.Path;
    }
}

