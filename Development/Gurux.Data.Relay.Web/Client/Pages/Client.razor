@page "/client"
@page "/client/tables"
@page "/client/transports"
@page "/client/state"
@page "/client/log"
@page "/client/overview"

@using Gurux.UI.Components.Tab
@inject NavigationManager Navigation

<TabControl Active="@(Path?.StartsWith('/') == true ? Path : $"/client/{Path}")" SelectionChanged="@SelectionChanged">
    <TabTextTemplate>
        <Image Value="@context.Icon" />
        <LocalizedText Value="@context.Text" />
    </TabTextTemplate>
    <ChildContent>
        <TabPage Path="/client/tables" Text="Tables" Icon="oi oi-list-rich">
            <HelpContext Topic="tables--tables-to-transfer" />
            <ClientTablesPanel />
        </TabPage>
        <TabPage Path="/client/transports" Text="Transports" Icon="oi oi-transfer">
            <HelpContext Topic="transports--transfer-connections" />
            <ModeTransportsPanel Mode="client" />
        </TabPage>
        <TabPage Path="/client/state" Text="State" Icon="oi oi-dashboard">
            <HelpContext Topic="state--transfer-state" />
            <ModeStatePanel Mode="client" Title="Client Runtime State" />
        </TabPage>
        <TabPage Path="/client/log" Text="Log" Icon="oi oi-spreadsheet">
            <HelpContext Topic="log--client-log" />
            <ModeEventsPanel Mode="client" Title="Client Log" />
        </TabPage>
        <TabPage Path="/client/overview" Text="Settings" Icon="oi oi-cog">
            <HelpContext Topic="settings--client-settings" />
            <ModeSettingsPanel Mode="client" Title="Client Settings" ShowClientActions="true" />
        </TabPage>
    </ChildContent>
</TabControl>

@code {

    private string? Path { get; set; }

    protected override void OnParametersSet()
    {
        Path = new Uri(Navigation.Uri).AbsolutePath;
    }

    /// <summary>
    /// User has selected a new tab.
    /// </summary>
    /// <param name="page">Tab page.</param>
    void SelectionChanged(TabPage page)
    {
        Path = page.Path;
    }
}

